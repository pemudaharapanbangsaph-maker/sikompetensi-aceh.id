// Prisma schema for Sistem Informasi Kompetensi Teknis BPSDM Aceh
// Internal system for Bidang Pengembangan dan Sertifikasi Kompetensi Teknis Inti BPSDM Aceh

 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====================== AUTH & USERS ======================

model User {
  id             String    @id @default(cuid()) @db.VarChar(30)
  username       String    @unique @db.VarChar(50)
  password       String    @db.VarChar(255)
  nama           String    @db.VarChar(255)
  email          String    @unique @db.VarChar(191)
  role           String    @default("OPERATOR") @db.VarChar(20) // SUPER_ADMIN | ADMIN_BIDANG | OPERATOR
  status         String    @default("AKTIF") @db.VarChar(10) // AKTIF | NONAKTIF
  tempatLahir    String?   @db.VarChar(100)
  tanggalLahir   DateTime?
  noTelp         String?   @db.VarChar(20)
  fotoUrl        String?   @db.VarChar(500)
  lastLogin      DateTime?
  loginAttempts  Int       @default(0)
  lockedUntil    DateTime?
  twoFactorSecret String?  @db.VarChar(255)
  twoFactorEnabled Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs    AuditLog[]
  backups      BackupHistory[]
  analisis     AnalisisKebutuhan[]
  pelatihan    Pelatihan[]
  evaluasi     Evaluasi[]
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String   @db.VarChar(50)
  aksi      String   @db.VarChar(20) // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, EXPORT, BACKUP, RESTORE
  modul     String   @db.VarChar(50) // DASHBOARD, PELATIHAN, UJI_KOMPETENSI, etc.
  deskripsi String   @db.Text
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
}

// ====================== MASTER DATA ======================

model Peserta {
  id              String   @id @default(cuid()) @db.VarChar(30)
  nip             String   @unique @db.VarChar(50)
  nama            String   @db.VarChar(255)
  jenisKelamin    String   @db.VarChar(1) // L | P
  tempatLahir     String?  @db.VarChar(100)
  tanggalLahir    DateTime?
  jabatan         String?  @db.VarChar(255)
  pangkatGolongan String?  @db.VarChar(50)
  unitKerja       String?  @db.VarChar(255)
  instansi        String?  @db.VarChar(255)
  pendidikan      String?  @db.VarChar(100)
  noTelp          String?  @db.VarChar(20)
  email           String?  @db.VarChar(191)
  alamat          String?  @db.Text
  fotoUrl         String?  @db.VarChar(500)
  status          String   @default("AKTIF") @db.VarChar(20)
  deleted         Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  angkatan   PesertaAngkatan[]
  nilai      Nilai[]
  kehadiran  Kehadiran[]
  evaluasi   Evaluasi[]
  sertifikat Sertifikat[]
}

model Pelatihan {
  id          String   @id @default(cuid()) @db.VarChar(30)
  kode        String   @unique @db.VarChar(50)
  nama        String   @db.VarChar(255)
  kategori    String   @db.VarChar(30) // TEKNIS | MANAJERIAL | FUNGSIONAL | SOSIAL_KULTURAL
  deskripsi   String?  @db.Text
  durasiHari  Int      @default(1)
  jp          Int      @default(8) // Jam Pelatihan
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  status      String   @default("AKTIF") @db.VarChar(10) // AKTIF | NONAKTIF
  deleted     Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  angkatan            Angkatan[]
  analisis            AnalisisKebutuhan[]
  pendaftaran         PendaftaranPortal[]
  analisisDiklatItems AnalisisDiklatItem[]
}

model Angkatan {
  id             String   @id @default(cuid()) @db.VarChar(30)
  pelatihanId    String   @db.VarChar(30)
  pelatihan      Pelatihan @relation(fields: [pelatihanId], references: [id], onDelete: Cascade)
  namaAngkatan   String   @db.VarChar(255)
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  lokasi         String?  @db.VarChar(255)
  metode         String   @default("TATAP_MUKA") @db.VarChar(20) // TATAP_MUKA | DARING | BLENDED
  kuota          Int      @default(30)
  status         String   @default("PERENCANAAN") @db.VarChar(20) // PERENCANAAN | BERJALAN | SELESAI | DIBATALKAN
  catatan        String?  @db.Text
  createdBy      String?
  deleted        Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  peserta       PesertaAngkatan[]
  kehadiran     Kehadiran[]
  evaluasi      Evaluasi[]
  ujiKompetensi UjiKompetensi[]
  dokumentasi   Dokumentasi[]
  sertifikat    Sertifikat[]
}

model PesertaAngkatan {
  id         String  @id @default(cuid()) @db.VarChar(30)
  angkatanId String  @db.VarChar(30)
  angkatan   Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)
  pesertaId  String  @db.VarChar(30)
  peserta    Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  status     String  @default("TERDAFTAR") @db.VarChar(20) // TERDAFTAR | LULUS | TIDAK_LULUS | DROP_OUT
  nilaiAkhir Float?
  createdAt  DateTime @default(now())

  @@unique([angkatanId, pesertaId])
}

model Dokumentasi {
  id         String   @id @default(cuid()) @db.VarChar(30)
  angkatanId String   @db.VarChar(30)
  angkatan   Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)
  judul      String   @db.VarChar(255)
  deskripsi  String?  @db.Text
  fileUrl    String   @db.VarChar(500)
  tipeFile   String   @db.VarChar(20) // IMAGE | VIDEO | DOKUMEN
  uploadedAt DateTime @default(now())
}

// ====================== PORTAL PENDAFTARAN ======================

model PendaftaranPortal {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  nama                String   @db.VarChar(255)
  jenisKelamin        String?  @db.VarChar(1)
  nip                 String   @unique @db.VarChar(50)
  pangkatGolongan     String?  @db.VarChar(50)
  tempatLahir         String?  @db.VarChar(100)
  tanggalLahir        DateTime?
  jabatan             String?  @db.VarChar(255)
  unitKerja           String?  @db.VarChar(255)
  instansi            String?  @db.VarChar(255)
  nomorHP             String?  @db.VarChar(20)
  nomorRekening       String?  @db.VarChar(50)
  npwp                String?  @db.VarChar(50)
  pelatihanId         String?
  pelatihan           Pelatihan? @relation(fields: [pelatihanId], references: [id], onDelete: SetNull)
  analisisDiklatItemId String?
  analisisDiklatItem   AnalisisDiklatItem? @relation(fields: [analisisDiklatItemId], references: [id], onDelete: SetNull)
  status              String   @default("MENUNGGU") @db.VarChar(20) // MENUNGGU | DITERIMA | DITOLAK
  catatanAdmin        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dokumen             DokumenPendaftaran[]
}

model DokumenPendaftaran {
  id             String   @id @default(cuid()) @db.VarChar(30)
  pendaftaranId  String   @db.VarChar(30)
  pendaftaran    PendaftaranPortal @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  tipe           String   @db.VarChar(30) // KTP | SURAT_TUGAS | NPWP | REK_BANK
  namaFile       String   @db.VarChar(255)
  ukuranFile     String   @db.VarChar(50)
  filePath       String   @db.VarChar(500)
  createdAt      DateTime @default(now())

  @@unique([pendaftaranId, tipe])
}

// ====================== ANALISIS KEBUTUHAN ======================

model AnalisisKebutuhan {
  id              String   @id @default(cuid()) @db.VarChar(30)
  judul           String   @db.VarChar(255)
  tahun           Int
  unitKerja       String   @db.VarChar(255)
  jenisKompetensi String   @db.VarChar(30) // TEKNIS | MANAJERIAL | FUNGSIONAL | SOSIAL_KULTURAL
  jumlahPegawai   Int      @default(0)
  tingkatKebutuhan String  @default("SEDANG") @db.VarChar(20) // RENDAH | SEDANG | TINGGI | SANGAT_TINGGI
  prioritas       String   @default("NORMAL") @db.VarChar(20) // RENDAH | NORMAL | TINGGI | URGENT
  pelatihanId     String?
  pelatihan       Pelatihan? @relation(fields: [pelatihanId], references: [id], onDelete: SetNull)
  catatan         String?  @db.Text
  status          String   @default("DRAFT") @db.VarChar(20) // DRAFT | DISETUJUI | DITOLAK | SELESAI
  dibuatOleh      String?
  user            User?    @relation(fields: [dibuatOleh], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalisisDiklatItem {
  id                     String    @id @default(cuid()) @db.VarChar(30)
  outcome                String    @default("") @db.Text
  programPrioritasRPJMA  String    @default("") @db.Text
  sasaranRPJMA           String    @default("") @db.Text
  skpaSasaran            String    @default("") @db.Text
  namaPelatihan          String    @default("") @db.VarChar(255)
  kategori               String    @default("TEKNIS") @db.VarChar(30) // TEKNIS | MANAJERIAL | FUNGSIONAL | SOSIAL_KULTURAL
  metodePembelajaran     String    @default("TATAP_MUKA") @db.VarChar(20) // TATAP_MUKA | DARING | BLENDED
  durasiHari             Int?      @default(0)
  pelatihanId            String?
  pelatihan              Pelatihan? @relation(fields: [pelatihanId], references: [id], onDelete: SetNull)
  durasiJP               Int       @default(0)
  targetOutput           String    @default("") @db.Text
  prioritas              String    @default("SEDANG") @db.VarChar(20) // TINGGI | SEDANG | RENDAH
  tahunPelaksanaan       Int       @default(2025)
  tanggalPelaksanaan     DateTime?
  status                 String    @default("AKTIF") @db.VarChar(20) // AKTIF | NONAKTIF
  dibuatOleh             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  pendaftaran            PendaftaranPortal[]
}

// ====================== UJI KOMPETENSI ======================

model Asesor {
  id              String   @id @default(cuid()) @db.VarChar(30)
  nip             String   @unique @db.VarChar(50)
  nama            String   @db.VarChar(255)
  bidangKeahlian  String   @db.VarChar(255)
  noSertifikat    String?  @db.VarChar(100)
  tanggalSertifikat DateTime?
  instansi        String?  @db.VarChar(255)
  email           String?  @db.VarChar(191)
  noTelp          String?  @db.VarChar(20)
  status          String   @default("AKTIF") @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ujiKompetensi   UjiKompetensiAsesor[]
}

model UjiKompetensi {
  id                String   @id @default(cuid()) @db.VarChar(30)
  kode              String   @unique @db.VarChar(50)
  angkatanId        String?
  angkatan          Angkatan? @relation(fields: [angkatanId], references: [id], onDelete: SetNull)
  tanggalUji        DateTime
  tempat            String   @db.VarChar(255)
  skemaSertifikasi  String   @db.VarChar(255)
  jumlahPeserta     Int      @default(0)
  status            String   @default("DIJADWALKAN") @db.VarChar(20) // DIJADWALKAN | BERLANGSUNG | SELESAI | DIBATALKAN
  catatan           String?  @db.Text
  deleted           Boolean  @default(false)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  asesor            UjiKompetensiAsesor[]
  nilai             Nilai[]
  sertifikat        Sertifikat[]
}

model UjiKompetensiAsesor {
  id              String        @id @default(cuid()) @db.VarChar(30)
  ujiKompetensiId String        @db.VarChar(30)
  ujiKompetensi   UjiKompetensi @relation(fields: [ujiKompetensiId], references: [id], onDelete: Cascade)
  asesorId        String        @db.VarChar(30)
  asesor          Asesor        @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  peran           String        @default("ASESOR") @db.VarChar(20) // ASESOR | PENGUJI | PENGAWAS

  @@unique([ujiKompetensiId, asesorId])
}

model Nilai {
  id              String  @id @default(cuid()) @db.VarChar(30)
  ujiKompetensiId String  @db.VarChar(30)
  ujiKompetensi   UjiKompetensi @relation(fields: [ujiKompetensiId], references: [id], onDelete: Cascade)
  pesertaId       String  @db.VarChar(30)
  peserta         Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  nilaiPreTest    Float?
  nilaiPostTest   Float?
  nilaiPraktik    Float?
  nilaiTeori      Float?
  nilaiAkhir      Float?
  statusKelulusan String  @default("BELUM") @db.VarChar(20) // LULUS | TIDAK_LULUS | BELUM
  catatan         String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ====================== KEHADIRAN & EVALUASI ======================

model Kehadiran {
  id              String   @id @default(cuid()) @db.VarChar(30)
  angkatanId      String   @db.VarChar(30)
  angkatan        Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)
  pesertaId       String   @db.VarChar(30)
  peserta         Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  tanggal         DateTime
  statusKehadiran String   @default("HADIR") @db.VarChar(10) // HADIR | SAKIT | IZIN | ALPA
  keterangan      String?  @db.Text
  createdAt       DateTime @default(now())

  @@unique([angkatanId, pesertaId, tanggal])
}

model Evaluasi {
  id            String   @id @default(cuid()) @db.VarChar(30)
  angkatanId    String?
  angkatan      Angkatan? @relation(fields: [angkatanId], references: [id], onDelete: SetNull)
  pesertaId     String?
  peserta       Peserta?  @relation(fields: [pesertaId], references: [id], onDelete: SetNull)
  jenisEvaluasi String   @db.VarChar(20) // PRE_TEST | POST_TEST | KUESIONER | KEPUASAN
  aspek         String?  @db.VarChar(255)
  nilai         Float
  catatan       String?  @db.Text
  diinputOleh   String?
  user          User?    @relation(fields: [diinputOleh], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

// ====================== SERTIFIKAT ======================

model Sertifikat {
  id               String         @id @default(cuid()) @db.VarChar(30)
  jenis            String         @db.VarChar(20) // PELATIHAN | UJI_KOMPETENSI
  angkatanId       String?
  angkatan         Angkatan?      @relation(fields: [angkatanId], references: [id], onDelete: SetNull)
  ujiKompetensiId  String?
  ujiKompetensi    UjiKompetensi? @relation(fields: [ujiKompetensiId], references: [id], onDelete: SetNull)
  pesertaId        String?
  peserta          Peserta?       @relation(fields: [pesertaId], references: [id], onDelete: SetNull)
  nomorSertifikat  String?        @db.VarChar(100)
  namaPeserta      String?        @db.VarChar(255)
  namaKegiatan     String?        @db.VarChar(255)
  file             String         @db.VarChar(500) // path ke file upload
  ukuranFile       String?        @db.VarChar(50)
  tanggalTerbit    DateTime?
  catatan          String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ====================== NOTIFIKASI EMAIL ======================

model NotifikasiEmail {
  id            String    @id @default(cuid()) @db.VarChar(30)
  subjek        String    @db.VarChar(255)
  isi           String    @db.Text
  penerima      String    @db.VarChar(191) // email tujuan
  status        String    @default("DRAF") @db.VarChar(20) // DRAF | TERKIRIM | GAGAL
  jenis         String?   @db.VarChar(20) // INFO | PENGINGAT | UNDANGAN
  referensiId   String?   @db.VarChar(30)
  referensiTipe String?   @db.VarChar(50)
  sentAt        DateTime?
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())
}

// ====================== BACKUP & SYSTEM ======================

model BackupHistory {
  id          String   @id @default(cuid()) @db.VarChar(30)
  namaFile    String   @db.VarChar(255)
  ukuran      String   @db.VarChar(50)
  tipe        String   @default("MANUAL") @db.VarChar(20) // MANUAL | OTOMATIS
  status      String   @default("BERHASIL") @db.VarChar(20) // BERHASIL | GAGAL
  dibuatOleh  String?
  user        User?    @relation(fields: [dibuatOleh], references: [id], onDelete: SetNull)
  catatan     String?  @db.Text
  createdAt   DateTime @default(now())
}

model Pengaturan {
  id        String   @id @default(cuid()) @db.VarChar(30)
  key       String   @unique @db.VarChar(191)
  value     String   @db.Text
  kategori  String   @default("UMUM") @db.VarChar(50)
  updatedAt DateTime @updatedAt
}
